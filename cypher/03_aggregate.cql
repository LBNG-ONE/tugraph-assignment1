// ============================================================
// 实验一 · 步骤三：自定义聚合查询设计
// ------------------------------------------------------------
// 【业务问题】影视资料库要回答 3 个聚合问题：
//   Q1 哪位导演的作品平均口碑最高？（需过滤作品数≥2，避免"一片成名"噪声）
//   Q2 哪位导演的"演员资源池"最大？（需两跳 + 去重计数）
//   Q3 各出品国的产量与平均评分分布如何？（需隐式分组）
// 【设计要点】
//   - Cypher 没有 GROUP BY，分组由聚合函数隐式触发（RETURN/WITH 中非聚合表达式即分组键）
//   - 用 WITH 做多阶段：先按导演聚合 → 再用 WHERE 对聚合结果做"HAVING"过滤
//   - COUNT(DISTINCT ...) 去重，避免同一演员多部合作被重复计数
// ============================================================


// ============================================================
// Q1【核心示例】导演作品数 ≥ 2 的口碑排行榜
// ------------------------------------------------------------
// 思路：MATCH 导演 -direct-> 影片
//       WITH 阶段按导演分组，聚合出作品数与平均分
//       WHERE 对聚合结果过滤（等价于 SQL 的 HAVING COUNT(*)>=2）
//       RETURN 排序输出 Top N
// ============================================================
MATCH (d:person)-[:direct]->(m:movie)
WITH d, COUNT(m) AS movieCount, AVG(m.rating) AS avgRating
WHERE movieCount >= 2
RETURN d.name AS 导演, movieCount AS 作品数, avgRating AS 平均评分
ORDER BY avgRating DESC, movieCount DESC
LIMIT 10


// ------------------------------------------------------------
// Q1-a 对照：不加 WHERE 会怎样？（一片成名的导演挤进榜单）
// ------------------------------------------------------------
MATCH (d:person)-[:direct]->(m:movie)
RETURN d.name AS 导演, COUNT(m) AS 作品数, AVG(m.rating) AS 平均评分
ORDER BY 平均评分 DESC
LIMIT 10


// ------------------------------------------------------------
// Q1-b 对照：按作品数量排序（"劳模导演"榜）
// ------------------------------------------------------------
MATCH (d:person)-[:direct]->(m:movie)
RETURN d.name AS 导演, COUNT(m) AS 作品数, AVG(m.rating) AS 平均评分
ORDER BY 作品数 DESC
LIMIT 5


// ============================================================
// Q2【进阶】导演的"演员资源池"规模
// ------------------------------------------------------------
// 两跳：导演 -direct-> 影片 <-acted_in- 演员
// 先用 WITH 把粒度定为 (导演, 影片)，算出该片演员数
// 再在外层按导演 sum 起来 —— 典型的多阶段聚合
// ============================================================
MATCH (d:person)-[:direct]->(m:movie)<-[:acted_in]-(a:person)
WITH d, m, COUNT(DISTINCT a) AS castSize
RETURN d.name AS 导演,
       COUNT(m) AS 影片数,
       SUM(castSize) AS 演员池规模
ORDER BY 演员池规模 DESC, 影片数 DESC
LIMIT 5


// ============================================================
// Q3【进阶】按出品国聚合：产量 + 平均评分
// ------------------------------------------------------------
// 隐式分组：RETURN 中 m.country 是非聚合表达式 → 自动成为分组键
// ============================================================
MATCH (m:movie)
RETURN m.country AS 出品国,
       COUNT(m) AS 影片数,
       AVG(m.rating) AS 平均评分,
       MAX(m.rating) AS 最高评分,
       MIN(m.rating) AS 最低评分
ORDER BY 影片数 DESC, 平均评分 DESC


// ============================================================
// Q4【进阶】演员口碑榜：出演过 ≥2 部且平均分最高的演员
// ============================================================
MATCH (p:person)-[:acted_in]->(m:movie)
WITH p, COUNT(m) AS movieCount, AVG(m.rating) AS avgRating
WHERE movieCount >= 2
RETURN p.name AS 演员, movieCount AS 出演片数, avgRating AS 平均评分
ORDER BY avgRating DESC
LIMIT 5


// ============================================================
// Q5【进阶】全库聚合：一次算出总量与均值（无分组键）
// ============================================================
MATCH (m:movie)
RETURN COUNT(m) AS 影片总数,
       AVG(m.rating) AS 全库平均评分,
       MAX(m.duration) AS 最长片长,
       MIN(m.duration) AS 最短片长
